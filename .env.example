# ---------------------------------------------------------------------------
# Nafij Netflix - environment variables
# Copy to .env.local for local dev. Cloudflare/GitHub deployments use .env.cloudflare.
# Never put viewer passwords or unrelated account credentials here.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# Public base URL. Locally http://localhost:3000, on Vercel your preview/prod URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- TMDB (server-side only, never exposed to the browser) -----------------
# v4 read access token (preferred). Dashboard: https://www.themoviedb.org/settings/api
TMDB_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiIzODE0YjIzMDdmYWZkY2RhMjBiZDBhYTJkMDNmMmVhYyIsIm5iZiI6MTc4ODA2MTkwNS42MzYsInN1YiI6IjZhOTNhOGQxZDE1MDljYTkzNjVhZTBkOCIsInNjb3BlcyI6WyJhcGlfcmVhZCJdLCJ2ZXJzaW9uIjoxfQ.NbWhALL82cJX3PvYtGt33QYQwPl6xUpdCz8wzskNDOk
# v3 API key. Optional fallback, used only if TMDB_TOKEN is empty.
TMDB_API_KEY=3814b2307fafdcda20bd0aa2d03f2eac
# Optional overrides
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=en-US
TMDB_REGION=US

# --- Supabase (auth + database) -------------------------------------------
# Project URL and anon key are public by design and safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS - keep it secret, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (optional) ----------------------------------------------
# Configure the values inside Supabase -> Authentication -> Providers -> Google.
# This flag only controls whether the "Continue with Google" button is rendered.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Video provider adapter -----------------------------------------------
# Registered ids: vidsrc | disabled  (see lib/video/providers)
NEXT_PUBLIC_VIDEO_PROVIDER=vidsrc
# Embed URL templates. Placeholders: {id} {season} {episode}
NEXT_PUBLIC_VIDEO_MOVIE_EMBED_TEMPLATE=https://vidsrc.sbs/embed/movie/{id}
NEXT_PUBLIC_VIDEO_TV_EMBED_TEMPLATE=https://vidsrc.sbs/embed/tv/{id}/{season}/{episode}

# --- Advertising layer -----------------------------------------------------
# Legitimate ad tags only. Leave AD_ENABLED=false until your provider is live.
NEXT_PUBLIC_AD_ENABLED=false
NEXT_PUBLIC_AD_PROVIDER=vast
NEXT_PUBLIC_PREROLL_ENABLED=false
NEXT_PUBLIC_MIDROLL_ENABLED=false
NEXT_PUBLIC_POSTROLL_ENABLED=false
# Minutes of guaranteed ad-free playback at the start of a title (5-10 typical).
NEXT_PUBLIC_INITIAL_AD_FREE_MINUTES=10
# Minutes between mid-rolls once the ad-free window has elapsed.
NEXT_PUBLIC_MIDROLL_INTERVAL_MINUTES=20
# Max mid-rolls per playback session (0 = unlimited).
NEXT_PUBLIC_MIDROLL_MAX_PER_SESSION=3
# VAST/VMAP tag URLs supplied by your ad provider.
NEXT_PUBLIC_AD_VAST_TAG_URL=
NEXT_PUBLIC_AD_VMAP_TAG_URL=
# Server-only credential for provider reporting APIs, if your provider needs one.
AD_PROVIDER_TAG=
AD_PROVIDER_SECRET=

# --- Display ad slots (reserved, empty by default) -------------------------
# Four in-flow slots exist in the layout: home-top, list-footer, detail-below
# and watch-below-player (see lib/ads/zones.ts). Each one renders NOTHING until
# the master switch is on AND the loader script, tag class and that slot's zone
# id are all filled in. Nothing is ever drawn over the player.
NEXT_PUBLIC_BANNER_ADS_ENABLED=false
# Label only, for your own reference. e.g. exoclick
NEXT_PUBLIC_AD_DISPLAY_NETWORK=exoclick
# The provider's loader script. Must be https (http values are ignored).
# ExoClick/magsrv uses: https://a.magsrv.com/ad-provider.js
NEXT_PUBLIC_AD_DISPLAY_SCRIPT_URL=
# The class name the provider tells you to put on its <ins> container.
NEXT_PUBLIC_AD_DISPLAY_TAG_CLASS=
# true = draw a dashed outline where each slot sits, so you can check the layout
# before a network exists. Automatically on in development.
NEXT_PUBLIC_AD_SLOT_OUTLINE=false
# Per-slot zone ids from your provider dashboard. Leave blank to keep a slot empty.
NEXT_PUBLIC_AD_ZONE_HOME_TOP=
NEXT_PUBLIC_AD_ZONE_LIST_FOOTER=
NEXT_PUBLIC_AD_ZONE_DETAIL_BELOW=
NEXT_PUBLIC_AD_ZONE_WATCH_BELOW_PLAYER=

# Browse Mode dock's 3 video slots, the legacy floating/in-page video ads, and
# the 5 player ad-opportunity slots shown during playback. Prefer pasting tags
# straight into config/ads.ts — these are only a fallback for keeping tags out
# of source control (a value in config/ads.ts always wins). Leave blank to
# keep a slot off.
NEXT_PUBLIC_AD_DOCK_VIDEO1_VAST_TAG_URL=
NEXT_PUBLIC_AD_DOCK_VIDEO2_VAST_TAG_URL=
NEXT_PUBLIC_AD_DOCK_VIDEO3_VAST_TAG_URL=
NEXT_PUBLIC_AD_FLOATING_VAST_TAG_URL=
NEXT_PUBLIC_AD_INPAGE_VAST_TAG_URL=
NEXT_PUBLIC_AD_SLOT1_VAST_TAG_URL=
NEXT_PUBLIC_AD_SLOT2_VAST_TAG_URL=
NEXT_PUBLIC_AD_SLOT3_VAST_TAG_URL=
NEXT_PUBLIC_AD_SLOT4_VAST_TAG_URL=
NEXT_PUBLIC_AD_SLOT5_VAST_TAG_URL=

# --- Optional extras -------------------------------------------------------
# Optional watch-progress tracking (requires the watch_progress table).
NEXT_PUBLIC_WATCH_PROGRESS_ENABLED=false

# --- Cloudflare deployment --------------------------------------------------
# The private repository deployment path uses .env.cloudflare. The Cloudflare
# build script loads that file and generates the Worker server fallback.

# --- Additional ad snippet placements --------------------------------------
NEXT_PUBLIC_AD_BANNER_SNIPPET=
NEXT_PUBLIC_AD_MOVIE_CARD_SNIPPET=
NEXT_PUBLIC_AD_SECTION_BANNER_SNIPPET=
NEXT_PUBLIC_AD_BROWSE_PROVIDER_SNIPPET=
NEXT_PUBLIC_AD_BROWSE_BANNER1_SNIPPET=
NEXT_PUBLIC_AD_BROWSE_BANNER2_SNIPPET=
NEXT_PUBLIC_AD_BROWSE_BANNER3_SNIPPET=

# Per-placement switches
NEXT_PUBLIC_AD_FLOATING_VIDEO_ENABLED=true
NEXT_PUBLIC_AD_INPAGE_VIDEO_ENABLED=false
NEXT_PUBLIC_AD_BANNER_ENABLED=false
NEXT_PUBLIC_AD_MOVIE_CARD_ENABLED=true
NEXT_PUBLIC_AD_SECTION_BANNER_ENABLED=true
NEXT_PUBLIC_AD_BROWSE_DOCK_ENABLED=true
