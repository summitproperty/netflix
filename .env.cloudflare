# ============================================================================
# Nafij Netflix — Cloudflare/GitHub environment
# ============================================================================
# This file is intentionally used by the Cloudflare build wrapper.
# Fill the values below, commit this file to your PRIVATE GitHub repository,
# then Cloudflare only needs to run: npm run cf:build
#
# Local development still uses .env.local exactly as before.
#
# IMPORTANT:
# - NEXT_PUBLIC_* values are browser-visible configuration.
# - TMDB_TOKEN / TMDB_API_KEY / SUPABASE_SERVICE_ROLE_KEY are server values.
# - Leave a tag/snippet blank to disable that individual ad slot.
# - Do not put viewer/user passwords in this file.
# ============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_URL=

# --- TMDB -------------------------------------------------------------------
# Prefer the TMDB v4 Read Access Token. If empty, the v3 API key is used.
TMDB_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiIzODE0YjIzMDdmYWZkY2RhMjBiZDBhYTJkMDNmMmVhYyIsIm5iZiI6MTc4ODA2MTkwNS42MzYsInN1YiI6IjZhOTNhOGQxZDE1MDljYTkzNjVhZTBkOCIsInNjb3BlcyI6WyJhcGlfcmVhZCJdLCJ2ZXJzaW9uIjoxfQ.NbWhALL82cJX3PvYtGt33QYQwPl6xUpdCz8wzskNDOk
TMDB_API_KEY=3814b2307fafdcda20bd0aa2d03f2eac
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=en-US
TMDB_REGION=US

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ohuekkumveiungxwtleo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_1NvMdmjKU3PTds7vJM-gfA_bdFU-jWe
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth -----------------------------------------------------------
# The actual Google provider credentials are configured in Supabase Auth.
# This flag only controls whether the Google button is shown by the app.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true

# --- Video provider ---------------------------------------------------------
NEXT_PUBLIC_VIDEO_PROVIDER=vidsrc
NEXT_PUBLIC_VIDEO_MOVIE_EMBED_TEMPLATE=https://vidsrc.sbs/embed/movie/{id}
NEXT_PUBLIC_VIDEO_TV_EMBED_TEMPLATE=https://vidsrc.sbs/embed/tv/{id}/{season}/{episode}

# --- Main video advertising (VAST/VMAP) ------------------------------------
NEXT_PUBLIC_AD_ENABLED=false
NEXT_PUBLIC_AD_PROVIDER=exoclick
NEXT_PUBLIC_PREROLL_ENABLED=false
NEXT_PUBLIC_MIDROLL_ENABLED=false
NEXT_PUBLIC_POSTROLL_ENABLED=false
NEXT_PUBLIC_INITIAL_AD_FREE_MINUTES=10
NEXT_PUBLIC_MIDROLL_INTERVAL_MINUTES=20
NEXT_PUBLIC_MIDROLL_MAX_PER_SESSION=3
NEXT_PUBLIC_AD_VAST_TAG_URL=
NEXT_PUBLIC_AD_VMAP_TAG_URL=

# Private server-side provider tag URL, if your provider supplies one.
# Used by /api/ads/vast as a server-side fallback.
AD_PROVIDER_TAG=

# --- Display/banner advertising --------------------------------------------
NEXT_PUBLIC_BANNER_ADS_ENABLED=false
NEXT_PUBLIC_AD_DISPLAY_NETWORK=exoclick
NEXT_PUBLIC_AD_DISPLAY_SCRIPT_URL=https://a.magsrv.com/ad-provider.js
NEXT_PUBLIC_AD_DISPLAY_TAG_CLASS=
NEXT_PUBLIC_AD_SLOT_OUTLINE=false

# Fixed display zones
NEXT_PUBLIC_AD_ZONE_HOME_TOP=
NEXT_PUBLIC_AD_ZONE_LIST_FOOTER=
NEXT_PUBLIC_AD_ZONE_DETAIL_BELOW=
NEXT_PUBLIC_AD_ZONE_WATCH_BELOW_PLAYER=

# --- Named VAST/video slots -------------------------------------------------
NEXT_PUBLIC_AD_DOCK_VIDEO1_VAST_TAG_URL=
NEXT_PUBLIC_AD_DOCK_VIDEO2_VAST_TAG_URL=
NEXT_PUBLIC_AD_DOCK_VIDEO3_VAST_TAG_URL=
NEXT_PUBLIC_AD_FLOATING_VAST_TAG_URL=
NEXT_PUBLIC_AD_INPAGE_VAST_TAG_URL=
NEXT_PUBLIC_AD_SLOT1_VAST_TAG_URL=
NEXT_PUBLIC_AD_SLOT2_VAST_TAG_URL=
NEXT_PUBLIC_AD_SLOT3_VAST_TAG_URL=
NEXT_PUBLIC_AD_SLOT4_VAST_TAG_URL=
NEXT_PUBLIC_AD_SLOT5_VAST_TAG_URL=

# --- Ad snippet slots -------------------------------------------------------
# Paste the exact provider-issued HTML/JS snippet for the corresponding slot.
# These can be ExoClick, Adsterra, or another provider's legitimate snippet.
# Keep empty when that placement is not being used.
NEXT_PUBLIC_AD_BANNER_SNIPPET=
NEXT_PUBLIC_AD_MOVIE_CARD_SNIPPET=
NEXT_PUBLIC_AD_SECTION_BANNER_SNIPPET=
NEXT_PUBLIC_AD_BROWSE_PROVIDER_SNIPPET=
NEXT_PUBLIC_AD_BROWSE_BANNER1_SNIPPET=
NEXT_PUBLIC_AD_BROWSE_BANNER2_SNIPPET=
NEXT_PUBLIC_AD_BROWSE_BANNER3_SNIPPET=

# Per-placement switches
NEXT_PUBLIC_AD_FLOATING_VIDEO_ENABLED=true
NEXT_PUBLIC_AD_INPAGE_VIDEO_ENABLED=false
NEXT_PUBLIC_AD_BANNER_ENABLED=false
NEXT_PUBLIC_AD_MOVIE_CARD_ENABLED=true
NEXT_PUBLIC_AD_SECTION_BANNER_ENABLED=true
NEXT_PUBLIC_AD_BROWSE_DOCK_ENABLED=true

# --- Optional watch progress ------------------------------------------------
NEXT_PUBLIC_WATCH_PROGRESS_ENABLED=false
